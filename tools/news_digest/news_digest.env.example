# Configuración del digest de noticias.
#
# Copiar a ~/news_digest.env en el servidor, rellenar y proteger:
#   chmod 600 ~/news_digest.env
#
# Este archivo contiene el token de publicación: NO se versiona.

# Token del RPC publish_news_digest. Solo habilita publicar digests: no lee ni
# escribe ninguna otra tabla. Para rotarlo, generar uno nuevo con
# `openssl rand -hex 24`, actualizarlo aquí y guardar su hash en Supabase:
#   insert into private_config (key, value)
#   values ('news_publish_token_sha256', encode(digest('<NUEVO>', 'sha256'), 'hex'))
#   on conflict (key) do update set value = excluded.value;
NEWS_PUBLISH_TOKEN=

# Clave anon del proyecto (la misma que ya viaja dentro del APK).
SUPABASE_ANON_KEY=

SUPABASE_URL=https://vhtorhsyqszoaeshlnjs.supabase.co

# En el propio servidor de Ollama, localhost evita salir a la red.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Titulares que se le pasan al modelo. Subirlo degrada la prosa de los modelos
# locales; bajarlo reduce de dónde elegir.
NEWS_MAX_CANDIDATES=50
